        <mxCell id="pafs" value="Part Affinity Fields (PAFs)&#xa;- Spatial relationships between keypoints (e.g. shoulder–elbow)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#cce5ff;strokeColor=#4d79ff;" parent="1" vertex="1">
          <mxGeometry x="650" y="240" width="300" height="100" as="geometry" />
