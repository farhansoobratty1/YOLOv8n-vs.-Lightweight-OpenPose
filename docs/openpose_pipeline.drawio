          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="backbone" value="Backbone (MobileNetV1 CNN)&#xa;- Extract visual features" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" parent="1" vertex="1">
          <mxGeometry x="330" y="130" width="260" height="80" as="geometry" />
