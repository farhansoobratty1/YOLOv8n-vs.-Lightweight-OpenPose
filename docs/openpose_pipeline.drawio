        <mxCell id="conf" value="Confidence Maps&#xa;- Probability of keypoint presence at each location" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d9ead3;strokeColor=#6aa84f;" parent="1" vertex="1">
